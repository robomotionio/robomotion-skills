# Tool credentials for this skill (all OPTIONAL — never block a run).
# Bind each to a Vault item in the Designer's Environment tab.
# The skill works as pure knowledge with none bound; CLIs activate when keys are set.

# ahrefs (CLI: ahrefs.js)
AHREFS_API_KEY
# dataforseo (CLI: dataforseo.js)
DATAFORSEO_LOGIN
DATAFORSEO_PASSWORD
# google-search-console (CLI: google-search-console.js)
#   GSC_ACCESS_TOKEN: OAuth access token — expires; refresh out-of-band
GSC_ACCESS_TOKEN
# keywords-everywhere (CLI: keywords-everywhere.js)
KEYWORDS_EVERYWHERE_API_KEY
# rankparse (CLI: rankparse.js)
RANKPARSE_API_KEY
# semrush (CLI: semrush.js)
SEMRUSH_API_KEY
# similarweb (CLI: similarweb.js)
SIMILARWEB_API_KEY
