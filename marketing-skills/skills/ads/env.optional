# env.optional — ads
#
# ALL OPTIONAL — gate-traced. Each integration CLI hard-gates on its own token
# (e.g. tools/clis/<tool>.js: `if (!TOKEN) { console.error('...required'); process.exit(1) }`),
# but this skill is knowledge that can use ANY of several alternative tools — or
# none at all. No single tool is a prerequisite (real fallback: a different tool,
# or pure-knowledge output), so every var below is OPTIONAL. The user supplies
# keys only for the tools they actually have.
# Tools this skill can use: adobe-analytics, coupler, dub-co, ga4, google-ads, linkedin-ads, meta-ads, rb2b, salesforce, segment, similarweb, sparktoro, supermetrics, tiktok-ads
ADOBE_ACCESS_TOKEN
ADOBE_CLIENT_ID
ADOBE_COMPANY_ID
COUPLER_API_KEY
GA4_ACCESS_TOKEN
GOOGLE_ADS_CUSTOMER_ID
GOOGLE_ADS_DEVELOPER_TOKEN
GOOGLE_ADS_TOKEN
LINKEDIN_ACCESS_TOKEN
META_ACCESS_TOKEN
META_AD_ACCOUNT_ID
SEGMENT_ACCESS_TOKEN
SEGMENT_WRITE_KEY
SIMILARWEB_API_KEY
SUPERMETRICS_API_KEY
TIKTOK_ACCESS_TOKEN
TIKTOK_ADVERTISER_ID
