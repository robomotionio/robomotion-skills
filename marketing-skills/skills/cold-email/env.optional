# env.optional — cold-email
#
# ALL OPTIONAL — gate-traced. Each integration CLI hard-gates on its own token
# (e.g. tools/clis/<tool>.js: `if (!TOKEN) { console.error('...required'); process.exit(1) }`),
# but this skill is knowledge that can use ANY of several alternative tools — or
# none at all. No single tool is a prerequisite (real fallback: a different tool,
# or pure-knowledge output), so every var below is OPTIONAL. The user supplies
# keys only for the tools they actually have.
# Tools this skill can use: apollo, clay, close, exa, firehose, gong, outreach, rb2b, sparktoro, zoominfo
APOLLO_API_KEY
CLAY_API_KEY
CLOSE_API_KEY
EXA_API_KEY
FIREHOSE_API_KEY
OUTREACH_ACCESS_TOKEN
ZOOMINFO_ACCESS_TOKEN
ZOOMINFO_PRIVATE_KEY
ZOOMINFO_USERNAME
