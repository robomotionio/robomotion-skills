# Real paid-API credentials for the end-to-end (real-result) tests.
#
# Copy this file to `tests/secrets.env` (gitignored) and fill in the keys you have.
# The real-test harness sources tests/secrets.env when GTM_PAID_TESTS=1; any test whose
# key is absent is skipped, so you only need the services you actually want to exercise.
#
#   cp tests/secrets.env.example tests/secrets.env   # then edit
#   GTM_PAID_TESTS=1 python3 -m unittest discover -s tests -p 'test_real_*.py'
#
# These tests spend real money/credits. GTM_MAX_SPEND_USD caps the per-call cost gate.

# ---- toggles ----
GTM_PAID_TESTS=
GTM_MAX_SPEND_USD=0.50

# ---- Apify (actor runs; free $5/mo credit) ----
APIFY_API_TOKEN=

# ---- Apollo (people-search free; enrich burns credits) ----
APOLLO_API_KEY=

# ---- DataForSEO (HTTP Basic; ~$0.05-0.10 per call) ----
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ---- MillionVerifier (email deliverability; free 100-credit tier) ----
MILLIONVERIFIER_API_KEY=

# ---- Phantombuster (agent launches) ----
PHANTOMBUSTER_API_KEY=

# ---- Dropcontact / HubSpot / Supabase (enrich / CRM / storage) ----
DROPCONTACT_API_KEY=
HUBSPOT_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
