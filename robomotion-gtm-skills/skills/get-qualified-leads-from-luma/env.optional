# env.optional — every paid service here has a keyless fallback.
# Extraction: if APIFY_API_TOKEN is set -> Apify Luma actor (full registered-guest profiles).
# If not -> keyless luma_scrape_pw.mjs direct-scrape (hosts + metadata only).
APIFY_API_TOKEN
# override the default Luma actor id
APIFY_LUMA_ACTOR
# Delivery: if SLACK_WEBHOOK_URL or SLACK_BOT_TOKEN is set -> Slack. If not -> the alert is
# written to a workspace file (slack_alert.py --out-file).
# incoming webhook
SLACK_WEBHOOK_URL
# alternative to SLACK_WEBHOOK_URL (chat.postMessage; needs --channel)
SLACK_BOT_TOKEN
# only if the qualification LLM is not platform-provided
ANTHROPIC_API_KEY
