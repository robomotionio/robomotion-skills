# env.optional — every paid service here has a keyless fallback.
# If SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set -> durable Supabase TAM/signals store
# (recommended; the substrate tam-builder writes). If not -> keyless --snapshots in /
# --signals-out workspace-file fallback.
SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY
# Phase-2 scraped signals (job postings, LinkedIn content/profile changes). If set -> Apify/
# PhantomBuster actors; if not -> the engager/jobs sub-skills degrade to keyless serp/Playwright.
APIFY_API_TOKEN
# LinkedIn alternative to Apify for Phase-2 scraping (+ cookie)
PHANTOMBUSTER_API_KEY
# LLM content analysis; Phase 2 degrades to non-LLM signals without it
ANTHROPIC_API_KEY
# Supabase table-name overrides (defaults: companies/signals/enrichment_log)
SIGNAL_COMPANIES_TABLE
SIGNAL_SIGNALS_TABLE
SIGNAL_LOG_TABLE
