# env.optional — paid/external services are optional; each has a keyless fallback that is the
# DEFAULT. Set a key only to upgrade quality/coverage. The doc still builds without any of these.

# --- Hostile-site scraping: review mining (G2/Capterra/Trustpilot) + ad copy (Meta Ad Library /
#     Google Ads Transparency), and any competitor page Playwright can't render ---
# If APIFY_API_TOKEN is set -> route those hostile pages through an Apify actor (better coverage
# on anti-bot review/ad sites). If not set -> default keyless path: fetch_competitors.py (stdlib)
# then the Playwright fallback fetch_competitors_js.mjs; if even Playwright is blocked, proceed
# with site + search evidence and note the gap. Apify is the last resort, never required.
APIFY_API_TOKEN

# --- SERP upgrade for competitor + review-page discovery (optional) ---
# By default the agent finds competitor/review URLs keyless (provided inputs + its own web
# search + direct fetch). If a SERP key is set -> use it to discover competitor pages, review
# URLs, and ad-library entries with better recall. If not set -> default keyless discovery.
# DataForSEO preferred; SERPER/SEARCHAPI are equivalent alternatives.
DATAFORSEO_LOGIN
DATAFORSEO_PASSWORD
SERPER_API_KEY
SEARCHAPI_API_KEY

# Robomotion Proxy (geo-targeting for region-locked competitor sites + scrape volume) is a
# platform feature, not a user key — no env var.
