# env.optional — enrichment / reliability / cross-run history.
# Apify Product Hunt actor (reliable, anti-block; costs credits). Without it, Playwright degrade.
APIFY_API_TOKEN
# Override the default Apify Product Hunt actor slug (default: tri_angle~product-hunt-scraper).
APIFY_PH_ACTOR
# Persistent cross-run history/dedup (else workspace CSV via dedup_history.py).
SUPABASE_URL
SUPABASE_KEY
