# env.optional — every paid service here has a keyless fallback.
# LinkedIn-profile source: if PHANTOMBUSTER_API_KEY (or APIFY_API_TOKEN) is set -> managed
# scraper (higher volume/reliability). If not -> keyless pb_profiles_pw.mjs Playwright + LI_AT.
# + a LinkedIn session cookie configured on the phantom
PHANTOMBUSTER_API_KEY
# alternative managed LinkedIn profile actor
APIFY_API_TOKEN
# configured Phantombuster profile-scraper agent id (or pass --agent-id)
PB_PROFILE_AGENT_ID
# LinkedIn li_at cookie for the keyless Playwright degrade (pb_profiles_pw.mjs)
LI_AT
# durable baseline store across runs (degrades to workspace file)
SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY
# only if LLM ICP scoring is not platform-provided
ANTHROPIC_API_KEY
