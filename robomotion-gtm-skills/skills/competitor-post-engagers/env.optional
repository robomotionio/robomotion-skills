# env.optional — each has a real fallback (one extraction path is enough; enrichment and
# state both degrade gracefully).
# primary extraction: post-discovery + engager actors (--source apify)
APIFY_API_TOKEN
# alt extraction (--source phantombuster); needs a LinkedIn cookie on the phantom
PHANTOMBUSTER_API_KEY
# configured PhantomBuster post-engager agent id (or --engagers-agent-id)
PB_ENGAGERS_AGENT_ID
# LinkedIn li_at cookie for the keyless Playwright degrade (--source playwright)
LI_AT
# Apollo People Match enrichment; without it -> profile-only pass-through
APOLLO_API_KEY
# email verification (enrich_apollo.py --verify); keyless syntax+MX fallback without it
MILLIONVERIFIER_API_KEY
# email-finding fallback when Apollo reveals none
DROPCONTACT_API_KEY
# mirror cross-run dedup history to Supabase (with SUPABASE_KEY)
SUPABASE_URL
# Supabase service/anon key for the dedup history table
SUPABASE_KEY
