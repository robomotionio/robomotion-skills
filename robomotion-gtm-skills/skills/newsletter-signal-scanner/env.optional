# env.optional
# IMAP connection tuning (defaults: 993 / INBOX).
IMAP_PORT
IMAP_FOLDER
# Optional ALT inbox source: if set -> hosted AgentMail inbox read; else -> IMAP (default).
# One inbox source (IMAP or AgentMail) is inherently required; this is not a keyless fallback.
AGENTMAIL_API_KEY
# Digest synthesis is normally the host agent's job; these only matter if a script-side LLM
# is wired in. Without any LLM the skill degrades to the templated --digest (non-LLM).
ANTHROPIC_API_KEY
OPENAI_API_KEY
# Digest delivery to Slack / email instead of a workspace markdown file.
SLACK_BOT_TOKEN
SENDGRID_API_KEY
RESEND_API_KEY
# Cross-run dedup + week-over-week topic counts (else workspace CSV via dedup_history.py).
SUPABASE_URL
SUPABASE_KEY
