# env.optional — durable state / enrichment / delivery only; the skill runs without these.
# Durable shared watchlist, baseline, and per-cycle snapshots (else local CSV store):
SUPABASE_URL
SUPABASE_KEY
AIRTABLE_API_KEY
# Reddit / X / review scraping depth:
APIFY_API_TOKEN
# LinkedIn founder/exec post monitoring:
PHANTOMBUSTER_API_KEY
# Structured SERP for per-cycle discovery searches (mentions/news/reactions).
# If set -> paid SERP (DataForSEO or Serper); if not -> the agent's own web search (default):
DATAFORSEO_LOGIN
DATAFORSEO_PASSWORD
SERPER_API_KEY
# Report delivery to the client channel (else workspace file):
SLACK_BOT_TOKEN
DISCORD_WEBHOOK_URL
TELEGRAM_BOT_TOKEN
# Bring-your-own-key synthesis instead of platform-default model (usually unset):
ANTHROPIC_API_KEY
OPENAI_API_KEY
