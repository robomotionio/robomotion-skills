# env.optional — enrichment / fallback only; the scan runs without these.
# Reddit / X / LinkedIn / review scraping at depth (else serp coverage, less structured):
APIFY_API_TOKEN
# Structured LinkedIn post search:
PHANTOMBUSTER_API_KEY
# Newsletter-inbox monitoring (only if configured for the client):
GMAIL_OAUTH_TOKEN
IMAP_PASSWORD
# Structured SERP for the time-modified industry / competitor sweep searches.
# If set -> paid SERP (DataForSEO or Serper); if not -> the agent's own web search (default):
DATAFORSEO_LOGIN
DATAFORSEO_PASSWORD
SERPER_API_KEY
# Bring-your-own-key synthesis instead of platform-default model (usually unset):
ANTHROPIC_API_KEY
OPENAI_API_KEY
