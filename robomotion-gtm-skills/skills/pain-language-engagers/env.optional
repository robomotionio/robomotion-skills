# env.optional — every paid service here has a keyless fallback.
# Extraction source: if APIFY_API_TOKEN (or PHANTOMBUSTER_API_KEY) is set -> managed actors
# (async run+poll, cost-gated). If not -> keyless pb_engagers_pw.mjs Playwright + LI_AT.
# Apify post-search + post-engagement actors (primary; cost-gated)
APIFY_API_TOKEN
# alt extraction source (LinkedIn post engagers phantom) + LI_AT on phantom
PHANTOMBUSTER_API_KEY
# configured post-engager phantom id (or --engagers-agent-id)
PB_ENGAGERS_AGENT_ID
# LinkedIn li_at cookie for the keyless Playwright degrade
LI_AT
# override default post-search actor (or --actor)
APIFY_POST_SEARCH_ACTOR
# override default post-engagement actor (or --actor)
APIFY_ENGAGEMENTS_ACTOR
# Apollo People Match enrichment (degrades to profile-only)
APOLLO_API_KEY
# email verification (enrich_apollo.py --verify); keyless syntax+MX fallback without it
MILLIONVERIFIER_API_KEY
# cross-run dedup mirror (with SUPABASE_KEY)
SUPABASE_URL
# Supabase service/anon key for the dedup history table
SUPABASE_KEY
# only if keyword-gen / final review LLM is not platform-provided
ANTHROPIC_API_KEY
