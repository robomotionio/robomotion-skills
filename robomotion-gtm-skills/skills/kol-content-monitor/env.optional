# env.optional — reliability / synthesis / history.
# Reliable X scraping via the x-mention-tracker sub-skill (costs credits).
APIFY_API_TOKEN
# Reliable/at-scale LinkedIn post scraping; without it, the Playwright degrade is used.
PHANTOMBUSTER_API_KEY
# LinkedIn session cookie (li_at) to improve the keyless Playwright LinkedIn path.
LINKEDIN_COOKIE
# KOL-set discovery via paid SERP: if set -> DataForSEO/Serper SERP to find/expand the tracked
# KOL list; else -> the host agent's keyless web search (default). Discovery only; never gates.
DATAFORSEO_LOGIN
DATAFORSEO_PASSWORD
SERPER_API_KEY
# Topic clustering + digest synthesis (normally the host agent; provider interchangeable).
ANTHROPIC_API_KEY
OPENAI_API_KEY
# Cross-run history for spike/trend detection (else single-run signals only, no Spike tag).
SUPABASE_URL
SUPABASE_KEY
