# env.optional
# Newsletter discovery via paid SERP: if set -> DataForSEO/Serper SERP for broader, more
# reliable result coverage; else -> the host agent's keyless web search (default). Discovery
# only; extraction (page_extract.py) is keyless regardless.
DATAFORSEO_LOGIN
DATAFORSEO_PASSWORD
SERPER_API_KEY
# Scoring / CPM estimation / ranking / outreach templates are normally the host agent's
# job; these only matter if a script-side LLM is wired in. Without any LLM the skill
# degrades to a raw discovered-newsletter list with no scoring/templates.
ANTHROPIC_API_KEY
OPENAI_API_KEY
# Persist the shortlist as a human-visible pipeline (else a workspace markdown file).
SUPABASE_URL
SUPABASE_KEY
AIRTABLE_API_KEY
