# env.optional — every paid service here has a keyless fallback; the skill runs without all.
# If APOLLO_API_KEY is set -> Apollo People Search + verified People Match (better quality,
# verified email + phone). If not -> keyless serp_search.py discovery + email pattern-guess.
APOLLO_API_KEY
# Email verification: if set -> MillionVerifier; if not -> keyless syntax + MX-record check.
MILLIONVERIFIER_API_KEY
# Email-finding fallback for contacts Apollo can't email (used by the Apollo path):
DROPCONTACT_API_KEY
