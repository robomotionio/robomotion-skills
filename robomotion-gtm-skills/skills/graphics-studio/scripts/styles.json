{
  "_comment": "Style catalog for graphics-studio. Each style is a set of CSS design tokens the driver binds to :root custom properties on any format template. Schema per style: {id, name, aesthetic, mood_tags[], palette{bg, surface, primary, accent, text, muted, gradient?}, typography{heading_font, body_font, font_stack, scale_ratio}, radius, shadow, spacing_unit, motifs}. extract_style.py emits an ad-hoc style with this same shape; brand mode (graphics.py --brand) synthesizes one too. Fonts are Google Fonts / web-safe families with explicit fallback stacks.",
  "_schema": {
    "id": "string slug",
    "name": "string",
    "aesthetic": "string",
    "mood_tags": "string[]",
    "palette": "{bg, surface, primary, accent, text, muted, gradient?}",
    "typography": "{heading_font, body_font, font_stack, scale_ratio}",
    "radius": "css length",
    "shadow": "css box-shadow",
    "spacing_unit": "css length",
    "motifs": "string layout/decor cues for the agent"
  },
