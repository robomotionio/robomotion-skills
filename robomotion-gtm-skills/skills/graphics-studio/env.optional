# env.optional — every var here only enriches; the graphic renders fully without any of them.
# Stock photos (absent -> source_images.py auto-falls back to deterministic keyless URLs):
UNSPLASH_ACCESS_KEY
# Generative imagery (enrichment alternative to stock photos):
LEONARDO_API_KEY
STABILITY_API_KEY
FAL_KEY
# Not used by any script (the host agent is the model). Listed only because content
# authoring + --ref vision refinement are performed by the agent, not a script:
ANTHROPIC_API_KEY
OPENAI_API_KEY
