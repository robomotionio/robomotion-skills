# env.optional — send-path, referral lookup, routing/tagging, do-not-contact storage
# (all degrade to draft-only + CSV export + manual routing).
#
# Send/route — if a send key is set -> send/route the response; else -> draft-only or
# export a tool-ready CSV (--tool generic_csv, the keyless default) to send manually.
# one-off declines; also SENDGRID_FROM_EMAIL
SENDGRID_API_KEY
# one-off declines; also RESEND_FROM_EMAIL
RESEND_API_KEY
# nurture routing
LEMLIST_API_KEY
# nurture routing
INSTANTLY_API_KEY
# verified sender, required only when sending via sendgrid
SENDGRID_FROM_EMAIL
# verified sender, required only when sending via resend
RESEND_FROM_EMAIL
#
# Enrichment / storage — all degrade to manual routing.
# if set -> CRM referral-contact lookup + routing/tagging; else -> manual
HUBSPOT_API_KEY
# if set -> find the right referral contact; else -> ICP persona only
APOLLO_API_KEY
# if set -> do-not-contact list / competitive-intel log; else -> workspace CSV ledger
SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY
