# env.optional — fallbacks / enrichment only; the skill runs without these.
# Apify Reddit/X actor for depth beyond keyless search. If set -> Apify actor; else ->
# `site:` web search + the keyless HN API (default):
APIFY_API_TOKEN
# LinkedIn engagement depth (PhantomBuster + a LinkedIn session cookie). If set ->
# PhantomBuster path; else -> `site:linkedin.com` web search (default):
PHANTOMBUSTER_API_KEY
# Dedup seen trends across recurring (cron) runs. If set -> Supabase store; else ->
# single-run output, no cross-run dedup (default):
SUPABASE_URL
SUPABASE_KEY
# Optional SERP upgrade for the X/Reddit/LinkedIn scan queries. If a DataForSEO (or Serper)
# key is set -> structured SERP API; else -> the agent's keyless web search (default):
DATAFORSEO_LOGIN
DATAFORSEO_PASSWORD
SERPER_API_KEY
# Proxy for SERP scans (Robomotion Proxy):
HTTPS_PROXY
