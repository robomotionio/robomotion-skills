# env.optional — paid/external services are optional; each has a keyless fallback that is
# the DEFAULT. Set a key only to upgrade quality/coverage. The skill runs fully without any.

# --- Hostile-site scraping (last resort for blogs the stdlib + Playwright fetch can't get) ---
# If APIFY_API_TOKEN is set -> route a too-hostile blog page through an Apify article-extractor
# actor. If not set -> default keyless path: fetch_content.py (stdlib HTTP) then the Playwright
# fallback fetch_content_js.mjs. Apify is only the last resort, never required.
APIFY_API_TOKEN

# --- SERP upgrade for URL discovery (optional) ---
# discover_urls.py is keyless by default (sitemap.xml -> same-host crawl). If a SERP key is set,
# the agent MAY instead query a search engine for the brand's best content URLs (better recall
# on sites with no/partial sitemap). If not set -> default keyless sitemap+crawl discovery.
# DataForSEO preferred; SERPER/SEARCHAPI are equivalent alternatives.
DATAFORSEO_LOGIN
DATAFORSEO_PASSWORD
SERPER_API_KEY
SEARCHAPI_API_KEY

# Robomotion Proxy (geo-targeting for region-locked / rate-limiting sites) is a platform
# feature, not a user key — no env var.
