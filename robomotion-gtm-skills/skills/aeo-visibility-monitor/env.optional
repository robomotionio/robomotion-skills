# env.optional — each gates only its own engine / channel / storage; the monitor runs without them.
# Additional answer engines (absent -> that engine is skipped, not a failure):
OPENAI_API_KEY
GEMINI_API_KEY
TAVILY_API_KEY
# Durable run history. If SUPABASE_URL/SUPABASE_KEY are set -> diff_runs.py persists each run
# to Supabase (table aeo_runs); absent -> the DEFAULT keyless fallback is a local JSONL ledger
# via `diff_runs.py --history <path>`. The skill always passes --history, so the monitor runs
# fully without Supabase; Supabase only adds durable cross-host/shared storage.
SUPABASE_URL
SUPABASE_KEY
# Alert channels — required only if alerting to a channel; absent -> alert written to workspace:
SLACK_BOT_TOKEN
DISCORD_WEBHOOK_URL
TELEGRAM_BOT_TOKEN
