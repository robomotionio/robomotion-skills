# env.optional — reliability / synthesis / cross-run history.
# Apify per-platform review actors (reliable; some pay-per-result). Without it, Playwright degrade.
APIFY_API_TOKEN
# Override the default per-platform Apify actor slugs.
APIFY_G2_ACTOR
APIFY_CAPTERRA_ACTOR
APIFY_TRUSTPILOT_ACTOR
# Only when LLM sentiment/theme synthesis is requested (the host agent normally does synthesis).
ANTHROPIC_API_KEY
# Persistent cross-run history/dedup (else workspace CSV via dedup_history.py).
SUPABASE_URL
SUPABASE_KEY
