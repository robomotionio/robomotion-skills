# env.optional
# If SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set -> durable Supabase REST store with
# cross-run dedup. If not -> workspace CSV ledger (default fallback; reuse the same --store
# path for persistence).
SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY
# Supabase table name override (default: contacts)
CONTACT_CACHE_TABLE
