# env.optional — every paid service here has a keyless fallback.
# Engager source: if APIFY_API_TOKEN (or PHANTOMBUSTER_API_KEY) is set -> managed actor
# (higher volume; cost-gated). If not -> keyless Playwright (--source playwright + LI_AT).
# managed engager actor (primary, cost-gated)
APIFY_API_TOKEN
# alt managed source (+ LinkedIn cookie on the phantom)
PHANTOMBUSTER_API_KEY
# LinkedIn li_at cookie: PhantomBuster session OR keyless Playwright degrade
LI_AT
# configured PhantomBuster post-engager agent id (or --engagers-agent-id)
PB_ENGAGERS_AGENT_ID
# enrichment: title/seniority/company/size/industry/email (profile-only degrade without it)
APOLLO_API_KEY
# email verification (enrich_apollo.py --verify); keyless syntax+MX fallback without it
MILLIONVERIFIER_API_KEY
# email-finding fallback when Apollo reveals none
DROPCONTACT_API_KEY
# optional shared cross-run dedup ledger (with SUPABASE_KEY)
SUPABASE_URL
# Supabase service/anon key for the dedup ledger
SUPABASE_KEY
