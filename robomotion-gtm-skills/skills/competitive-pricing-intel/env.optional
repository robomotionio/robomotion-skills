# env.optional — durable history / enrichment only; the skill runs without these.
# Shared durable snapshot history (else the local CSV store under ${WORKSPACE}/supabase/):
SUPABASE_URL
SUPABASE_KEY
AIRTABLE_API_KEY
# Deeper Reddit / community reaction mining when the renderer is blocked:
APIFY_API_TOKEN
# Structured SERP for the pricing-announcement / reaction searches.
# If set -> paid SERP (DataForSEO or Serper); if not -> the agent's own web search (default):
DATAFORSEO_LOGIN
DATAFORSEO_PASSWORD
SERPER_API_KEY
# Bring-your-own-key synthesis instead of platform-default model (usually unset):
ANTHROPIC_API_KEY
OPENAI_API_KEY
