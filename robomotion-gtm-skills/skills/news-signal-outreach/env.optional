# env.optional — enrichment / send-path keys (all degrade to a keyless default).
# if set -> people-finding / company resolution; else -> keyless serp + email pattern-guess
APOLLO_API_KEY
# if set -> verify deliverability; else -> local syntax/dedup (higher bounce risk)
MILLIONVERIFIER_API_KEY
# if set -> email-finding fallback; else -> pattern-guess
DROPCONTACT_API_KEY
# Send/launch — if a send key is set -> launch the sequence via cold-email-outreach;
# else -> export a tool-ready CSV (the keyless default) to send manually.
# sequenced email
LEMLIST_API_KEY
# sequenced email
INSTANTLY_API_KEY
# one-off email
SENDGRID_API_KEY
# one-off email
RESEND_API_KEY
# if set -> automated LinkedIn send (with LINKEDIN_SESSION_COOKIE); else -> manual/CSV
PHANTOMBUSTER_API_KEY
