# env.optional — enrichment / fallback only; the skill runs without these.
# Reddit / X / LinkedIn / review scraping at depth (else serp covers the basics):
APIFY_API_TOKEN
# Structured LinkedIn activity at scale:
PHANTOMBUSTER_API_KEY
# Durable profile history when ongoing monitoring (step 6) is enabled:
SUPABASE_URL
SUPABASE_KEY
