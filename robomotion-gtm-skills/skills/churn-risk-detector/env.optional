# env.optional — only when the customer list / signals are read from a tool (not CSV).
# CRM read for the customer list (fetch_customers.py) — set the one matching --crm:
HUBSPOT_API_KEY
PIPEDRIVE_API_TOKEN
SALESFORCE_ACCESS_TOKEN
SALESFORCE_INSTANCE_URL
# Slack as a communication-signal source + summary push:
SLACK_BOT_TOKEN
# Persist per-run scores for week-over-week trend history:
SUPABASE_URL
SUPABASE_KEY
