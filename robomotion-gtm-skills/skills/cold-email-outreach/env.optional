# env.optional — send/sequencing keys + email verification (all degrade).
#
# Send/sequencing — if a key is set -> launch the sequence/send; else -> export a
# tool-ready CSV (--tool generic_csv) to send manually (the keyless default).
# sequenced cold email
LEMLIST_API_KEY
# sequenced cold email
INSTANTLY_API_KEY
# one-off send (touch 1 only); also SENDGRID_FROM_EMAIL
SENDGRID_API_KEY
# one-off send (touch 1 only); also RESEND_FROM_EMAIL
RESEND_API_KEY
# verified sender, required only when using --tool sendgrid
SENDGRID_FROM_EMAIL
# verified sender, required only when using --tool resend
RESEND_FROM_EMAIL
#
# Email deliverability verification — if set -> MillionVerifier; else -> local
# syntax + dedup checks (higher bounce risk).
MILLIONVERIFIER_API_KEY
