# env.optional — only if ingesting tickets from, or publishing to, an external help-desk/CMS.
# Provide the relevant vendor's API key (e.g. Zendesk/Intercom) used via a `core` HTTP call;
# no specific var is hard-wired into this skill's scripts. Examples:
ZENDESK_API_TOKEN
INTERCOM_ACCESS_TOKEN
# Not used by any script (the host agent is the model) — article generation is the agent's job:
ANTHROPIC_API_KEY
OPENAI_API_KEY
