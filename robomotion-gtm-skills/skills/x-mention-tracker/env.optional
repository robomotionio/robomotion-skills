# env.optional — reliability / cross-run history.
# Apify Tweet Actor route. Without it, use the Playwright fallback.
APIFY_API_TOKEN
# Optional Actor route. Default: apidojo~tweet-scraper.
# Set xquik~x-tweet-scraper to use Xquik.
APIFY_TWITTER_ACTOR
# Persistent cross-run history/dedup (else workspace CSV via dedup_history.py).
SUPABASE_URL
SUPABASE_KEY
