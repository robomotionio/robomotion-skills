# env.optional — reliability / cross-run history.
# Apify tweet-scraper actor (the reliable X path; costs credits). Without it, Playwright degrade.
APIFY_API_TOKEN
# Override the default Apify tweet-scraper actor slug (default: apidojo~tweet-scraper).
APIFY_TWITTER_ACTOR
# Persistent cross-run history/dedup (else workspace CSV via dedup_history.py).
SUPABASE_URL
SUPABASE_KEY
