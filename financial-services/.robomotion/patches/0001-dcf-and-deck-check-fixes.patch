+def period_markers(line: str) -> list[tuple[int, int, str]]:
+    """(start, end, period) for every period marker in a line, in order."""
+    markers = []
+    for m in PERIOD_PATTERN.finditer(line):
+        year = m.group('fy') or m.group('yr')
+        if len(year) == 2:
+            year = f"20{year}"
+        sfx = (m.group('sfx') or '').upper()
+        markers.append((m.start(), m.end(), year + ('' if sfx in ('', 'A') else sfx)))
+    return markers
