+    "EBITDA was $20m in FY2023 and $25m in FY2024": $25m sits nearer FY2023."""
+    for m_start, _m_end, period in markers:
+        if end <= m_start < next_start:
+            return period
+    before = [p for m_start, m_end, p in markers if m_end <= start]
+    return before[-1] if before else ''
 
 
